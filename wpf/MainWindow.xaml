<Window x:Class="UntamedManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Untamed Manager · Untamed Kingdom" Icon="/Assets/UntamedManager.ico"
 Width="1600" Height="900" MinWidth="780" MinHeight="520"
 WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceWindow}"
 Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged"
 UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <LinearGradientBrush x:Key="HeroBack" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#092529" Offset="0"/><GradientStop Color="#174D48" Offset="0.52"/><GradientStop Color="#8D8148" Offset="0.85"/><GradientStop Color="#183A35" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cave" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#112D31" Offset="0"/><GradientStop Color="#102327" Offset="0.7"/><GradientStop Color="#0C1C20" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Night" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#F0091C1D" Offset="0"/>
   <GradientStop Color="#B0082021" Offset="0.42"/>
   <GradientStop Color="#00082021" Offset="0.83"/>
  </LinearGradientBrush>
  <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource NavButton}"/>
  <Style x:Key="MapCardButton" TargetType="Button">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,12,12"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Card" Background="#1B252B" BorderBrush="#334249"
        BorderThickness="1" CornerRadius="8" ClipToBounds="True" SnapsToDevicePixels="True">
        <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="#5BC4B7"/>
        <Setter TargetName="Card" Property="Background" Value="#233037"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="#74BDB2"/>
        <Setter TargetName="Card" Property="Opacity" Value="0.88"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Card" Property="Opacity" Value="0.4"/>
       </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Background="{StaticResource SurfaceSidebar}">
   <Grid.RowDefinitions><RowDefinition Height="136"/><RowDefinition Height="*"/><RowDefinition Height="67"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" ClipToBounds="True">
     <Rectangle Fill="#111C20"/>
     <Image x:Name="BrandArtwork" Stretch="UniformToFill" Opacity="0.86" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
     <Rectangle Fill="#A5071719" IsHitTestVisible="False"/>
     <StackPanel Margin="20,0,8,16" VerticalAlignment="Bottom">
      <TextBlock Text="UNTAMED" Foreground="#F2FFF9" FontSize="26" FontWeight="Bold"/>
      <TextBlock Text="K I N G D O M" Foreground="#83F1CA" FontSize="14" FontWeight="SemiBold" Margin="1,-1,0,0"/>
      <TextBlock Text="ASA  •  COMMAND CENTER" Foreground="#B6D9CD" FontSize="9" FontWeight="SemiBold" Margin="1,7,0,0"/>
     </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="NavigationMenu" Margin="0,18,0,10">
     <TextBlock Text="MUNKATERÜLET" Foreground="#859DA1" FontSize="10"
       FontWeight="SemiBold" Margin="22,3,0,11"/>
     <Button Content="⌂   Áttekintés" Style="{StaticResource NavItem}" Tag="dashboard" Click="Navigate_Click"/>
     <Button Content="▤   Szerverek" Style="{StaticResource NavItem}" Tag="servers" Click="Navigate_Click"/>
     <Button Content="◇   Cluster" Style="{StaticResource NavItem}" Tag="cluster" Click="Navigate_Click"/>
     <Button Content="⬡   Modok" Style="{StaticResource NavItem}" Tag="mods" Click="Navigate_Click"/>
     <Button Content="✳   Pluginok" Style="{StaticResource NavItem}" Tag="plugins" Click="Navigate_Click"/>
     <Button Content="▣   Mentések" Style="{StaticResource NavItem}" Tag="backups" Click="Navigate_Click"/>
     <Button Content="⚙   Műveletek" Style="{StaticResource NavItem}" Tag="operations" Click="Navigate_Click"/>
     <Button Content="☷   Beállítások" Style="{StaticResource NavItem}" Tag="settings" Click="Navigate_Click"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" ClipToBounds="True">
    <Image x:Name="FooterArtwork" Stretch="UniformToFill" Opacity="0.2" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Rectangle Fill="#C0151C21"/>
    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
      <Border BorderBrush="#385A54" BorderThickness="1" Background="#252D31" CornerRadius="7" Padding="7">
       <TextBlock x:Name="ModeFooterText" Text="◆  HELYI MANAGER" Foreground="#C8DAD6" FontWeight="SemiBold" FontSize="10" TextAlignment="Center"/>
      </Border>
      <TextBlock Text="STORE-V1  ·  VÉDETT" Foreground="#839A9A" FontSize="9" Margin="3,7,0,0"/>
    </StackPanel>
   </Grid>
  </Grid>
  <Grid Grid.Column="1" Background="{StaticResource SurfaceWindow}">
   <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{StaticResource GraphiteHeader}" BorderBrush="{StaticResource GraphiteBorder}" BorderThickness="0,0,0,1">
    <Grid Margin="20,0,20,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
      <TextBlock Text="UNTAMED KINGDOM  /  CONTROL CENTER" TextTrimming="CharacterEllipsis" FontSize="14" Foreground="{StaticResource GraphitePrimary}" FontWeight="SemiBold"/>
      <TextBlock Text="LOCAL  ·  CLUSTER OPERATIONS" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{StaticResource GraphiteMuted}" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
      <TextBlock x:Name="DemoModeIndicator" Text="DEMO" FontSize="11" FontWeight="Bold" Foreground="#FFD28C" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
      <Button x:Name="DemoToggle" Content="▶ DEMO" Style="{StaticResource GoldAction}" Padding="12,8" Margin="0,0,8,0" Click="DemoMode_Click" AutomationProperties.Name="Offline DEMO mód be- és kikapcsolása"/>
      <Border x:Name="VersionContainer" Background="{StaticResource GraphiteRaised}" BorderBrush="{StaticResource GraphiteBorder}" BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,0,8,0"><TextBlock x:Name="VersionBadge" Text="WPF" Foreground="#73DDC8" FontSize="11"/></Border>
      <Border x:Name="SupervisorContainer" Background="{StaticResource GraphiteRaised}" BorderBrush="{StaticResource GraphiteBorder}" BorderThickness="1" CornerRadius="7" Padding="10,8"><TextBlock x:Name="SupervisorBadge" Text="Supervisor: ellenőrzés" Foreground="#F4BB78" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="146"/></Border>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="Dashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceWindow}">
     <StackPanel Margin="18,0,18,14">
      <Border Height="200" Background="#0C2525" BorderBrush="#315F56" BorderThickness="1"
 CornerRadius="16" ClipToBounds="True" Margin="0,13,0,17">
 <Grid>
  <Image x:Name="HeroImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
   Opacity="0.82" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
   <Image.RenderTransform><ScaleTransform ScaleX="1.015" ScaleY="1.015"/></Image.RenderTransform>
  </Image>
  <Rectangle IsHitTestVisible="False">
   <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#F208191C" Offset="0"/>
    <GradientStop Color="#DD0B2325" Offset="0.38"/>
    <GradientStop Color="#8B0E2A29" Offset="0.76"/>
    <GradientStop Color="#6A0A2022" Offset="1"/>
   </LinearGradientBrush></Rectangle.Fill>
  </Rectangle>
  <Ellipse x:Name="AmbientGlow" HorizontalAlignment="Right" VerticalAlignment="Top"
   Width="310" Height="240" Fill="#2856F8BB" Opacity="0.28" IsHitTestVisible="False"/>
  <Grid x:Name="DashboardHeroContent" Margin="27,18,20,20" SizeChanged="DashboardHeroContent_SizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock Text="ARK: SURVIVAL ASCENDED  /  NEON KINGDOM" Foreground="#99F8CE" FontWeight="SemiBold" FontSize="11" Margin="1,0,0,9"/>
    <TextBlock Text="UNTAMED KINGDOM" Foreground="#F4FFFC" FontSize="34" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
    <TextBlock Text="Cluster Command Center" Foreground="#A6E9D4" FontSize="18" FontWeight="SemiBold" Margin="1,3,0,0"/>
    <TextBlock Text="Helyi vezérlés  •  biztonságos clustermegfigyelés" Foreground="#C5D7D4" FontSize="12"
     TextTrimming="CharacterEllipsis" Margin="1,14,0,0"/>
   </StackPanel>
   <StackPanel x:Name="DashboardHeroActions" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
    <Button Style="{StaticResource PrimaryAction}" Content="Szerverek kezelése" Tag="servers" Click="Navigate_Click" MinWidth="140"/>
    <Button Style="{StaticResource ActionButton}" Content="Mod Center" Tag="mods" Click="Navigate_Click" MinWidth="140"/>
    <Button Style="{StaticResource ActionButton}" Content="Frissítések" Tag="license" Click="Navigate_Click" MinWidth="140"/>
   </StackPanel>
  </Grid>
 </Grid>
</Border>
       <UniformGrid x:Name="DashboardKpis" Columns="4" Margin="0,10,0,0" SizeChanged="DashboardKpis_SizeChanged">
       <Border Style="{StaticResource NeonStatPanel}">
        <StackPanel>
         <TextBlock Text="◇  TÉRKÉPEK" Foreground="{StaticResource TextSoft}" FontSize="11"/>
         <TextBlock x:Name="ClusterMapCount" Text="0" Foreground="{StaticResource TextStrong}" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/>
         <TextBlock Text="Regisztrált / utoljára látott" FontSize="10" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource NeonStatPanel}">
        <StackPanel>
         <TextBlock Text="▶  FUTÓ SZERVEREK" Foreground="{StaticResource TextSoft}" FontSize="11"/>
         <TextBlock x:Name="RunningServerKpi" Text="—" Foreground="{StaticResource AccentLight}" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/>
         <TextBlock Text="Igazolt helyi / DEMO-futás" FontSize="10" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource NeonStatPanel}">
        <StackPanel>
         <TextBlock Text="♙  JÁTÉKOSOK" Foreground="{StaticResource TextSoft}" FontSize="11"/>
         <TextBlock x:Name="PlayersKpi" Text="—" Foreground="{StaticResource TextStrong}" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/>
         <TextBlock Text="Csak hiteles adat / DEMO-minta" FontSize="10" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource NeonStatPanel}">
        <StackPanel>
         <TextBlock Text="▤  GAZDAGÉPEK" Foreground="{StaticResource TextSoft}" FontSize="11"/>
         <TextBlock x:Name="ClusterHostCount" Text="1" Foreground="{StaticResource TextStrong}" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,3"/>
         <TextBlock Text="Helyi és megfigyelt LAN" FontSize="10" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Border>
      </UniformGrid>

      <Grid x:Name="DashboardColumns" SizeChanged="DashboardColumns_SizeChanged" Margin="0,15,0,18">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7*" MinWidth="405"/>
        <ColumnDefinition Width="3*" MinWidth="270"/>
       </Grid.ColumnDefinitions>
       <Border x:Name="DashboardServerPane" Grid.Column="0" Background="{StaticResource SurfacePanel}"
               BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1"
               CornerRadius="10" Padding="12,12,8,10" Margin="0,0,12,0">
        <StackPanel>
         <DockPanel Margin="5,0,4,12" LastChildFill="False">
          <TextBlock Text="Szerverek / cluster" Foreground="{StaticResource TextStrong}"
                     FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Content="⟳ Frissítés"
                  Click="DashboardRefresh_Click" Style="{StaticResource ActionButton}"
                  AutomationProperties.Name="Dashboard állapotok frissítése"/>
         </DockPanel>
         <TextBlock Text="KÉPES MAPFLOTTA  /  KATTINTS A RÉSZLETEKHEZ"
 Foreground="#80BCB4" FontSize="10" FontWeight="SemiBold" Margin="6,1,0,12"/>
       <Border x:Name="MapListEmpty" Background="#152629" BorderBrush="#3D6467" BorderThickness="1"
              CornerRadius="14" Padding="25,22" Margin="0,0,10,14" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Készen áll az első szervered" FontSize="22" FontWeight="SemiBold" Foreground="#ECFFF8"/>
          <TextBlock Text="Még nincs regisztrált map. Választhatsz egy helyi telepítést, vagy egyből felfedezheted a kezelőfelületet offline mintaclusterrel."
                     FontSize="13" Foreground="#B3CAC7" TextWrapping="Wrap" Margin="0,7,0,15"/>
          <WrapPanel>
            <Button Style="{StaticResource PrimaryAction}" Content="＋  Map hozzáadása" Click="Navigate_Click" Tag="servers"/>
            <Button Style="{StaticResource GoldAction}" Content="▶  DEMO kipróbálása" Click="DemoMode_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="ServerCards" HorizontalAlignment="Stretch">
 <ItemsControl.ItemsPanel><ItemsPanelTemplate>
  <UniformGrid Columns="2" SizeChanged="DashboardMapTiles_SizeChanged"/>
 </ItemsPanelTemplate></ItemsControl.ItemsPanel>
 <ItemsControl.ItemTemplate><DataTemplate>
  <Button Style="{StaticResource MapCardButton}" Height="166" HorizontalAlignment="Stretch"
   Margin="0,0,10,10" Tag="{Binding}" Click="Map_Click" ToolTip="{Binding Caption}"
   AutomationProperties.Name="{Binding Name}">
   <Grid ClipToBounds="True">
    <Image Source="{Binding CoverImage}" Stretch="UniformToFill" Opacity="0.7"
     IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Rectangle IsHitTestVisible="False"><Rectangle.Fill>
     <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#F30B171C" Offset="0"/><GradientStop Color="#D91A2A2C" Offset="0.62"/>
      <GradientStop Color="#7410181C" Offset="1"/>
     </LinearGradientBrush>
    </Rectangle.Fill></Rectangle>
    <Grid Margin="16,12,16,12">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" LastChildFill="True">
      <Border Background="#BD123B35" BorderBrush="#477A6B" BorderThickness="1" CornerRadius="5"
       Padding="7,4" DockPanel.Dock="Right">
       <TextBlock Text="{Binding SourceBadge}" FontSize="9" Foreground="{Binding BadgeForeground}" FontWeight="Bold"/>
      </Border>
      <TextBlock Text="ARK  /  MAP INSTANCE" Foreground="#9CE8D5" FontSize="10"
       FontWeight="SemiBold" VerticalAlignment="Center"/>
     </DockPanel>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,5,0,4">
      <TextBlock Text="{Binding Name}" Foreground="#F4FFFA" FontSize="21" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Status}" Foreground="#C0DED8" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="HOST  " Foreground="#85BCB6" FontSize="10"/>
       <TextBlock Text="{Binding Host}" Foreground="#E2F1EC" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <TextBlock Text="JÁTÉKOS  " Foreground="#85BCB6" FontSize="10"/>
       <TextBlock Text="{Binding PlayerDisplay}" Foreground="#E2F1EC" FontSize="11" FontWeight="SemiBold"/>
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
  </Button>
 </DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl>

        </StackPanel>
       </Border>
       <StackPanel x:Name="DashboardSidePane" Grid.Column="1">
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
         <StackPanel>
          <TextBlock Text="Gazdagépek / infrastruktúra" Foreground="{StaticResource TextStrong}"
                     FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <ItemsControl x:Name="HostCards">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border MinHeight="94" Margin="0,0,0,9" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1" CornerRadius="8" Padding="13,10">
          <StackPanel>
           <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
           <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding TrustState}" FontSize="11" Foreground="{Binding Accent}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
           <Grid Margin="0,10,0,0">
            <Grid.Style>
             <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding HasTelemetry}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="35"/><ColumnDefinition Width="*"/>
             <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="17"/></Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="CPU" Foreground="{StaticResource TextSoft}" FontSize="10"/>
            <ProgressBar Grid.Column="1" Value="{Binding CpuPercent,FallbackValue=0}" Style="{StaticResource PremiumMeter}"
                         Maximum="100" Height="6" Margin="4,1,7,0" VerticalAlignment="Top"/>
            <TextBlock Grid.Column="2" Text="{Binding CpuLabel}" Foreground="{StaticResource TextSoft}" FontSize="10" TextAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="RAM" Foreground="{StaticResource TextSoft}" FontSize="10"/>
            <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding RamPercent,FallbackValue=0}"
                         Style="{StaticResource PremiumMeter}" Maximum="100" Height="6" Margin="4,1,7,0" VerticalAlignment="Top"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RamLabel}" Foreground="{StaticResource TextSoft}" FontSize="10" TextAlignment="Right"/>
           </Grid>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>

         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
         <StackPanel>
          <TextBlock Text="Erőforrások és felügyelet" FontSize="16"
                     FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,6"/>
      <StackPanel Margin="0,4,0,0">

       <Border Style="{StaticResource NeonStatPanel}" Margin="0,0,0,9">
        <StackPanel><TextBlock Text="LOCAL SYSTEM / CPU + MEMORY" FontSize="11" Foreground="#8BAAAE" Margin="0,0,0,6"/>
         <TextBlock x:Name="LocalHostResourceStatus" Text="Helyi CPU / RAM: még nincs mért Windows-adat" Foreground="#DCEEE8" TextWrapping="Wrap" FontSize="12"/></StackPanel>
       </Border>
       <Border Style="{StaticResource NeonStatPanel}" Margin="0,0,0,9">
        <StackPanel><TextBlock Text="SUPERVISOR / PROCESS OBSERVATION" FontSize="11" Foreground="#8BAAAE" Margin="0,0,0,6"/>
         <TextBlock x:Name="SupervisorStatus" Text="Supervisor: Ismeretlen – nincs friss, hitelesített mérés" TextWrapping="Wrap" Foreground="#C5D9D9" FontSize="12"/></StackPanel>
       </Border>
      </StackPanel>


         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
         <StackPanel>
          <TextBlock Text="Legutóbbi állapot / biztonság" FontSize="16"
                     FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,7"/>
          <Grid Margin="0,0,0,10">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="Konfigurált modok" FontSize="11" Foreground="{StaticResource TextSoft}"/>
           <TextBlock Grid.Column="1" x:Name="ConfiguredModCount" Text="—" FontSize="12"
                      FontWeight="SemiBold" Foreground="{StaticResource AccentLight}"/>
          </Grid>
          <TextBlock x:Name="ModReadingCoverage" Text="Nincs még mérés" FontSize="10"
                     Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Grid Margin="0,0,0,8">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <TextBlock Text="Friss, hiteles LAN-peer" FontSize="11" Foreground="{StaticResource TextSoft}"/>
           <TextBlock Grid.Column="1" x:Name="ClusterOnlineCount" Text="0" FontSize="12"
                      FontWeight="SemiBold" Foreground="{StaticResource AccentLight}"/>
          </Grid>
      <Border Background="#14272B" BorderBrush="#354E51" BorderThickness="1"
              CornerRadius="11" Padding="13,11" Margin="0,6,12,10">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="◉  Monitoring" Tag="monitoring"
                  Click="Navigate_Click" Style="{StaticResource ActionButton}" Padding="11,6"/>
          <StackPanel>
            <TextBlock Text="OPERATIONAL SNAPSHOT" Foreground="#79BBAF" FontSize="10"
                       FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="DashboardOperationsLine" Text="Folyamatok, játékosok és RCON állapota még nincs hitelesítve."
                       Foreground="#CCDCDD" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

         </StackPanel>
        </Border>
        <TextBlock Text="Store-v1 · megőrzött formátum · távoli adatok csak hiteles friss peerből"
                   Foreground="{StaticResource TextSoft}" FontSize="10" TextWrapping="Wrap" Margin="9,0,0,8"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="OtherPage" Background="{StaticResource SurfaceWindow}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="{StaticResource GraphitePageMargin}">
      <Border CornerRadius="14" Height="132" Background="{StaticResource GraphitePanel}" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,15">
       <Grid>
        <Image Source="{Binding Source, ElementName=HeroImage}" Stretch="UniformToFill" Opacity="0.65" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource Night}" IsHitTestVisible="False"/>
        <StackPanel VerticalAlignment="Center" Margin="18,7,18,7">
         <TextBlock x:Name="PageEyebrow" Text="UNTAMED KINGDOM  /  MANAGEMENT" Foreground="#99F1D9" FontSize="12" FontWeight="SemiBold"/>
         <TextBlock x:Name="PageTitle" Text="Szerverek" Style="{StaticResource GraphitePageTitle}" Margin="0,2,0,2"/>
         <TextBlock x:Name="PageDescription" Text="Adatelemzés" Foreground="#B8E2D7" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
       </Grid>
      </Border>
