<Window x:Class="UntamedManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Untamed Manager · Untamed Kingdom" Icon="/Assets/UntamedManager.ico"
 Width="1672" Height="941" MinWidth="1200" MinHeight="760"
 WindowStartupLocation="CenterScreen" Background="#07191B"
 Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <LinearGradientBrush x:Key="HeroBack" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#092529" Offset="0"/><GradientStop Color="#174D48" Offset="0.52"/><GradientStop Color="#8D8148" Offset="0.85"/><GradientStop Color="#183A35" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cave" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#112D31" Offset="0"/><GradientStop Color="#102327" Offset="0.7"/><GradientStop Color="#0C1C20" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Night" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#F0091C1D" Offset="0"/>
   <GradientStop Color="#B0082021" Offset="0.42"/>
   <GradientStop Color="#00082021" Offset="0.83"/>
  </LinearGradientBrush>
  <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource NavButton}">
   <Setter Property="Margin" Value="12,2"/>
  </Style>
  <Style x:Key="MapCardButton" TargetType="Button">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,13,14"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Effect">
    <Setter.Value><DropShadowEffect Color="#00E6C0" BlurRadius="13" Opacity="0.19" ShadowDepth="0"/></Setter.Value>
   </Setter>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Card" Background="#0B2829" BorderBrush="#498F84" BorderThickness="1" CornerRadius="13" ClipToBounds="True" RenderTransformOrigin="0.5,0.5">
       <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
       <Grid>
        <ContentPresenter/>
        <Border x:Name="HoverGlow" BorderBrush="#7BF9D4" BorderThickness="2" CornerRadius="12" Opacity="0" IsHitTestVisible="False"/>
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="#90FFCF"/>
        <Trigger.EnterActions>
         <BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.032" Duration="0:0:0.18"/>
          <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.032" Duration="0:0:0.18"/>
          <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.18"/>
         </Storyboard></BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
         <BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.20"/>
          <DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.20"/>
          <DoubleAnimation Storyboard.TargetName="HoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
         </Storyboard></BeginStoryboard>
        </Trigger.ExitActions>
       </Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Card" Property="Opacity" Value="0.78"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Background="#06191A">
   <Grid.RowDefinitions><RowDefinition Height="188"/><RowDefinition Height="*"/><RowDefinition Height="162"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" ClipToBounds="True">
     <Rectangle Fill="#051A1A"/>
     <Image x:Name="BrandArtwork" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="NavigationMenu" Margin="0,12,0,12">
     <TextBlock Text="IRÁNYÍTÓKÖZPONT" Foreground="#91AFAA" FontSize="11" Margin="24,3,0,4"/>
     <Button Content="⌂    Áttekintés" Style="{StaticResource NavItem}" Tag="dashboard" Click="Navigate_Click" Background="#22513C"/>
     <Button Content="▤    Szerverek" Style="{StaticResource NavItem}" Tag="servers" Click="Navigate_Click"/>
     <Button Content="◈    Cluster nézet" Style="{StaticResource NavItem}" Tag="cluster" Click="Navigate_Click"/>
     <TextBlock Text="TARTALOM ÉS KONFIGURÁCIÓ" Foreground="#91AFAA" FontSize="11" Margin="24,12,0,5"/>
     <Button Content="◇    CurseForge modok" Style="{StaticResource NavItem}" Tag="mods" Click="Navigate_Click"/>
     <Button Content="✳    ASA API / pluginok" Style="{StaticResource NavItem}" Tag="plugins" Click="Navigate_Click"/>
     <Button Content="▤    INI szerkesztő" Style="{StaticResource NavItem}" Tag="ini" Click="Navigate_Click"/>
     <TextBlock Text="ÜZEMELTETÉS" Foreground="#91AFAA" FontSize="11" Margin="24,12,0,5"/>
     <Button Content="▣    Mentések" Style="{StaticResource NavItem}" Tag="backups" Click="Navigate_Click"/>
     <Button Content="▦    Cluster Vault / SQL adatok" Style="{StaticResource NavItem}" Tag="data" Click="Navigate_Click"/>
     <Button Content="⟳    SteamCMD Update Center" Style="{StaticResource NavItem}" Tag="steam" Click="Navigate_Click"/>
     <Button Content="⌘    RCON konzol" Style="{StaticResource NavItem}" Tag="rcon" Click="Navigate_Click"/>
     <Button Content="◉    Monitoring / Események" Style="{StaticResource NavItem}" Tag="monitoring" Click="Navigate_Click"/>
     <Button Content="⌁    Hálózat / jitter mérés" Style="{StaticResource NavItem}" Tag="network" Click="Navigate_Click"/>
     <Button Content="✉    Discord szerverstátusz" Style="{StaticResource NavItem}" Tag="discord" Click="Navigate_Click"/>
     <Button Content="⛨    Recovery Center (TEST)" Style="{StaticResource NavItem}" Tag="recovery" Click="Navigate_Click"/>
     <Button Content="◷    Ütemezések" Style="{StaticResource NavItem}" Tag="schedules" Click="Navigate_Click"/>
     <TextBlock Text="ALKALMAZÁS" Foreground="#91AFAA" FontSize="11" Margin="24,12,0,5"/>
     <Button Content="✧    Licenc / Frissítés" Style="{StaticResource NavItem}" Tag="license" Click="Navigate_Click"/>
     <Button Content="☑    Fejlesztési állapot / funkciók" Style="{StaticResource NavItem}" Tag="readiness" Click="Navigate_Click"/>
     <Button Content="▧    Aláírt Manager-panelek" Style="{StaticResource NavItem}" Tag="extensions" Click="Navigate_Click"/>
     <Button Content="⚙    Beállítások" Style="{StaticResource NavItem}" Tag="settings" Click="Navigate_Click"/>
     <Button Content="✧    Beállítóvarázsló" Style="{StaticResource NavItem}" Tag="setup" Click="Navigate_Click"/>
     <Button Content="◉    LAN párosítás" Style="{StaticResource NavItem}" Tag="lan" Click="Navigate_Click"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" ClipToBounds="True">
    <Image x:Name="FooterArtwork" Stretch="UniformToFill" Opacity="0.86" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Rectangle Fill="#3B001D1B"/>
    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
      <Border BorderBrush="#35D0A5" BorderThickness="1" Background="#D3052520" CornerRadius="8" Padding="8">
       <TextBlock x:Name="ModeFooterText" Text="◆  HELYI MANAGER" Foreground="#B8FFCE" FontWeight="SemiBold" FontSize="10" TextAlignment="Center"/>
      </Border>
      <TextBlock Text="Store-írás tiltva   •   helyi Supervisor" Foreground="#D8F5ED" FontSize="10" Margin="3,8,0,0"/>
    </StackPanel>
   </Grid>
  </Grid>
  <Grid Grid.Column="1" Background="#061819">
   <Grid.RowDefinitions><RowDefinition Height="59"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#092223" BorderBrush="#3B8072" BorderThickness="0,0,0,1">
    <Grid Margin="20,0,20,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
      <TextBlock Text="UNTAMED KINGDOM / CONTROL CENTER" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="#DDF2E7" FontWeight="SemiBold"/>
      <TextBlock Text="Windows WPF · ASA és LAN-kezelés" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#8BBAB3" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
      <TextBlock x:Name="DemoModeIndicator" Text="DEMO" FontSize="11" FontWeight="Bold" Foreground="#FFD28C" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
      <Button x:Name="DemoToggle" Content="▶ DEMO" Style="{StaticResource GoldAction}" Padding="12,8" Margin="0,0,8,0" Click="DemoMode_Click" AutomationProperties.Name="Offline DEMO mód be- és kikapcsolása"/>
      <Border Background="#203F3B" CornerRadius="8" Padding="10,8" Margin="0,0,8,0"><TextBlock x:Name="VersionBadge" Text="WPF" Foreground="#73DDC8" FontSize="11"/></Border>
      <Border Background="#433122" CornerRadius="8" Padding="10,8"><TextBlock x:Name="SupervisorBadge" Text="Supervisor: ellenőrzés" Foreground="#F4BB78" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="146"/></Border>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="Dashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#061819">
     <StackPanel Margin="18,0,18,14">
      <Border Height="225" BorderBrush="#356C65" BorderThickness="0,0,0,1" CornerRadius="0" ClipToBounds="True" Background="{StaticResource HeroBack}">
       <Grid>
        <Canvas ClipToBounds="True">
         <Path Fill="#163E35" Opacity="0.75" Data="M0 209 L95 157 170 190 280 103 380 160 525 113 676 170 811 102 940 187 1140 135 1340 207 1340 290 0 290Z"/>
         <Path Fill="#0A2B26" Data="M0 234 L101 193 220 225 350 147 499 231 624 189 786 233 940 182 1120 216 1340 209 1340 290 0 290Z"/>
         <Path Stroke="#61E9CB" StrokeThickness="9" Opacity="0.75" Data="M906 52 L906 213"/>
         <Path Fill="#113D3B" Stroke="#5EAF9A" StrokeThickness="2" Data="M883 214 L899 111 909 61 928 112 946 214Z"/>
         <Path Fill="#9BE96F" Opacity="0.42" Data="M893 121 L908 79 920 121Z"/>
         <Path Fill="#071719" Stroke="#70A982" StrokeThickness="3" Data="M1003 178 C1013 118 1059 74 1137 76 C1183 77 1204 97 1210 131 L1263 141 1221 160 1203 166 C1190 191 1177 207 1152 210 L1162 260 1130 260 1110 217 1060 217 1037 262 1008 262 1025 209 1003 178Z"/>
         <Path Fill="#0A2420" Data="M1204 140 L1282 156 1220 166Z"/>
         <Ellipse Fill="#DDF9A0" Width="8" Height="8" Canvas.Left="1183" Canvas.Top="121"/>
         <Path Fill="#061618" Data="M0 270 L77 235 101 267 156 215 189 271 279 222 310 290 0 290Z"/>
        </Canvas>
        <Image x:Name="HeroImage" Source="/Assets/kingdom-hero.jpg" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.98" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform ScaleX="1.015" ScaleY="1.015"/></Image.RenderTransform></Image><Rectangle Fill="{StaticResource Night}"/>
        <Ellipse x:Name="AmbientGlow" HorizontalAlignment="Right" VerticalAlignment="Top" Width="430" Height="300" Margin="0,-64,-85,0" Fill="#1066FFE0" Opacity="0.12" IsHitTestVisible="False"/>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,0,300,0">
         <TextBlock Text="ARK: SURVIVAL ASCENDED" FontWeight="SemiBold" FontSize="12" Foreground="#A6F873"/>
         <TextBlock Text="UNTAMED KINGDOM" FontSize="38" FontWeight="Black" Foreground="White" Margin="0,11,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Effect><DropShadowEffect Color="#A6F2F1" BlurRadius="9" ShadowDepth="0" Opacity="0.37"/></TextBlock.Effect></TextBlock>
         <TextBlock Text="CONTROL CENTER  /  HELYI ÉS LAN MAPOK" FontSize="15" Foreground="#73E3CD" Margin="0,4,0,0"/>
         <TextBlock Text="Helyi mapok · hitelesített LAN-peer · offline működés" FontSize="13" Foreground="#E7F5EF" Margin="0,13,0,0"/>
         <StackPanel Orientation="Horizontal" Margin="0,19,0,0">
          <Button Style="{StaticResource PrimaryAction}" Content="▤  Szerverek kezelése  ❯" Tag="servers" Click="Navigate_Click"/>
          <Button Style="{StaticResource ActionButton}" Content="✣  Mod Center" Tag="mods" Click="Navigate_Click"/>
          <Button Style="{StaticResource ActionButton}" Content="▥  Mentések" Tag="backups" Click="Navigate_Click"/>
          <Button Style="{StaticResource GoldAction}" Content="↻  Frissítések" Tag="license" Click="Navigate_Click"/>
         </StackPanel>
        </StackPanel>
       </Grid>
      </Border>
      <Border Style="{StaticResource NeonStatPanel}" Margin="0,10,0,0">
       <TextBlock x:Name="LocalHostResourceStatus" Text="Helyi CPU / RAM: még nincs mért Windows-adat" Foreground="#DCEEE8" TextWrapping="Wrap" FontSize="12"/>
      </Border>
      <Border Style="{StaticResource NeonStatPanel}" Margin="0,10,0,0">
       <TextBlock x:Name="SupervisorStatus" Text="Supervisor: Ismeretlen – nincs friss, hitelesített mérés" TextWrapping="Wrap" Foreground="#9DB7B2" FontSize="12"/>
      </Border>
      <UniformGrid Columns="4" Margin="0,10,0,0">
       <Border Style="{StaticResource NeonStatPanel}"><StackPanel><TextBlock Text="◇  TÉRKÉPEK" Foreground="#9DB7B2"/><TextBlock x:Name="ClusterMapCount" Text="0" Foreground="#A6F873" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock Text="Regisztrált / utoljára látott" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
       <Border Style="{StaticResource NeonStatPanel}"><StackPanel><TextBlock Text="▤  GAZDAGÉPEK" Foreground="#9DB7B2"/><TextBlock x:Name="ClusterHostCount" Text="1" Foreground="White" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock Text="Külön Windows gépek" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
       <Border Style="{StaticResource NeonStatPanel}"><StackPanel><TextBlock Text="⬡  HELYI MODOK" Foreground="#9DB7B2"/><TextBlock x:Name="ConfiguredModCount" Text="—" Foreground="#73DDC8" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock x:Name="ModReadingCoverage" Text="Nincs még mérés" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
       <Border Style="{StaticResource AmberStatPanel}"><StackPanel><TextBlock Text="◉  FRISS LAN-PEER" Foreground="#9DB7B2"/><TextBlock x:Name="ClusterOnlineCount" Text="0" Foreground="#F4BB78" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock Text="0, ha nincs hiteles peer-mérés" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
      </UniformGrid>
      <DockPanel LastChildFill="False" Margin="0,6,12,9">
       <TextBlock Text="Gazdagépek / infrastruktúra" Foreground="White" DockPanel.Dock="Left" FontSize="21" FontWeight="Bold"/>
       <TextBlock Text="◈  Store: csak olvasó adapter · veszélyes műveletek tiltva" DockPanel.Dock="Right" Foreground="#7DE6C8" FontSize="11" VerticalAlignment="Center"/>
      </DockPanel>
      <ItemsControl x:Name="HostCards">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border Width="360" Height="105" Margin="0,0,14,12" Background="#102C2C" BorderBrush="{Binding Accent}" BorderThickness="1" CornerRadius="13" Padding="16,12">
          <StackPanel>
           <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
           <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#B8DED5" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding TrustState}" FontSize="11" Foreground="{Binding Accent}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel Margin="0,12,12,13" LastChildFill="True">
       <Button DockPanel.Dock="Right" Content="⟳  Mérések frissítése" Style="{StaticResource ActionButton}" Padding="13,8" Click="DashboardRefresh_Click" AutomationProperties.Name="Dashboard állapotok frissítése"/>
       <TextBlock Text="Regisztrált cluster szerverek" Foreground="White" FontWeight="Bold" FontSize="21" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock x:Name="MapListEmpty" Text="Még nincs regisztrált helyi map, és nincs hitelesített távoli maplista. A Szerverek oldalon adhatsz hozzá helyi mapot." FontSize="13" Foreground="#C9DCD4" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
      <ItemsControl x:Name="ServerCards">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Style="{StaticResource MapCardButton}" Width="230" Height="178" Tag="{Binding}" Click="Map_Click" ToolTip="{Binding Caption}">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="96"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Grid Grid.Row="0" ClipToBounds="True">
            <Border Background="{Binding CoverBrush}"/>
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/><Rectangle Fill="{Binding CoverBrush}" Opacity="0.10"/>
            <Rectangle Fill="#1208181B"/>
            <Border Background="#CD08191C" Height="19" VerticalAlignment="Bottom"/>
            <Border Background="#DB0B2221" BorderBrush="#458C7A" BorderThickness="1" Padding="7,4" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Margin="0,8,9,0"><TextBlock Text="{Binding SourceBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/></Border>
           </Grid>
           <StackPanel Grid.Row="1" Margin="11,5,5,3">
            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Host}" Foreground="#70DDCB" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Status}" Foreground="#C2D6CF" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
           </StackPanel>
          </Grid>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="OtherPage" Background="#071C1D" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="24,22,24,40">
      <Border CornerRadius="15" Height="171" BorderBrush="#328F7C" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,20">
       <Grid>
        <Image Source="/Assets/kingdom-hero.jpg" Stretch="UniformToFill" Opacity="0.60"/>
        <Rectangle Fill="{StaticResource Night}"/>
        <StackPanel VerticalAlignment="Center" Margin="26,14,280,14">
         <TextBlock x:Name="PageEyebrow" Text="UNTAMED KINGDOM  /  MANAGEMENT" Foreground="#99F1D9" FontSize="12" FontWeight="SemiBold"/>
         <TextBlock x:Name="PageTitle" Text="Szerverek" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,9,0,6"/>
         <TextBlock x:Name="PageDescription" Text="Adatelemzés" Foreground="#B8E2D7" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
       </Grid>
      </Border>
      <StackPanel x:Name="PageBody"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="#0D2425" BorderBrush="#325650" BorderThickness="0,1,0,0" Padding="15,7">
    <DockPanel LastChildFill="False"><TextBlock x:Name="ClusterStatusText" Text="●  Nincs kézzel hozzáadott helyi map · peer nincs csatlakoztatva" Foreground="#73DDC8" FontSize="11"/>
     <TextBlock Text="UNTAMED KINGDOM" DockPanel.Dock="Right" Foreground="#92AAA6" FontSize="11"/></DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
