<Window x:Class="UntamedManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Untamed Manager · Untamed Kingdom" Icon="/Assets/UntamedManager.ico"
 Width="1440" Height="850" MinWidth="1050" MinHeight="670"
 WindowStartupLocation="CenterScreen" Background="{StaticResource SurfaceWindow}"
 Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.Resources>
  <LinearGradientBrush x:Key="HeroBack" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#092529" Offset="0"/><GradientStop Color="#174D48" Offset="0.52"/><GradientStop Color="#8D8148" Offset="0.85"/><GradientStop Color="#183A35" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Cave" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#112D31" Offset="0"/><GradientStop Color="#102327" Offset="0.7"/><GradientStop Color="#0C1C20" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Night" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#F0091C1D" Offset="0"/>
   <GradientStop Color="#B0082021" Offset="0.42"/>
   <GradientStop Color="#00082021" Offset="0.83"/>
  </LinearGradientBrush>
  <Style x:Key="NavItem" TargetType="Button" BasedOn="{StaticResource NavButton}"/>
  <Style x:Key="MapCardButton" TargetType="Button">
   <Setter Property="Padding" Value="0"/>
   <Setter Property="Margin" Value="0,0,12,12"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Card" Background="#1B252B" BorderBrush="#334249"
        BorderThickness="1" CornerRadius="8" ClipToBounds="True" SnapsToDevicePixels="True">
        <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="#5BC4B7"/>
        <Setter TargetName="Card" Property="Background" Value="#233037"/>
       </Trigger>
       <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Card" Property="BorderBrush" Value="#74BDB2"/>
        <Setter TargetName="Card" Property="Opacity" Value="0.88"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Card" Property="Opacity" Value="0.4"/>
       </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Background="{StaticResource SurfaceSidebar}">
   <Grid.RowDefinitions><RowDefinition Height="126"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" ClipToBounds="True">
     <Rectangle Fill="#051A1A"/>
     <Image x:Name="BrandArtwork" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel x:Name="NavigationMenu" Margin="0,18,0,10">
     <TextBlock Text="MUNKATERÜLET" Foreground="#859DA1" FontSize="10"
       FontWeight="SemiBold" Margin="22,3,0,11"/>
     <Button Content="⌂   Áttekintés" Style="{StaticResource NavItem}" Tag="dashboard" Click="Navigate_Click"/>
     <Button Content="▤   Szerverek" Style="{StaticResource NavItem}" Tag="servers" Click="Navigate_Click"/>
     <Button Content="◇   Cluster" Style="{StaticResource NavItem}" Tag="cluster" Click="Navigate_Click"/>
     <Button Content="⬡   Modok" Style="{StaticResource NavItem}" Tag="mods" Click="Navigate_Click"/>
     <Button Content="✳   Pluginok" Style="{StaticResource NavItem}" Tag="plugins" Click="Navigate_Click"/>
     <Button Content="▣   Mentések" Style="{StaticResource NavItem}" Tag="backups" Click="Navigate_Click"/>
     <Button Content="⚙   Műveletek" Style="{StaticResource NavItem}" Tag="operations" Click="Navigate_Click"/>
     <Button Content="☷   Beállítások" Style="{StaticResource NavItem}" Tag="settings" Click="Navigate_Click"/>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="2" ClipToBounds="True">
    <Image x:Name="FooterArtwork" Stretch="UniformToFill" Opacity="0.86" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Rectangle Fill="#3B001D1B"/>
    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
      <Border BorderBrush="#35D0A5" BorderThickness="1" Background="#D3052520" CornerRadius="8" Padding="8">
       <TextBlock x:Name="ModeFooterText" Text="◆  HELYI MANAGER" Foreground="#B8FFCE" FontWeight="SemiBold" FontSize="10" TextAlignment="Center"/>
      </Border>
      <TextBlock Text="Store-írás tiltva   •   helyi Supervisor" Foreground="#D8F5ED" FontSize="10" Margin="3,8,0,0"/>
    </StackPanel>
   </Grid>
  </Grid>
  <Grid Grid.Column="1" Background="{StaticResource SurfaceWindow}">
   <Grid.RowDefinitions><RowDefinition Height="59"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#092223" BorderBrush="#3B8072" BorderThickness="0,0,0,1">
    <Grid Margin="20,0,20,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
      <TextBlock Text="UNTAMED KINGDOM / CONTROL CENTER" TextTrimming="CharacterEllipsis" FontSize="13" Foreground="#DDF2E7" FontWeight="SemiBold"/>
      <TextBlock Text="Windows WPF · ASA és LAN-kezelés" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#8BBAB3" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
      <TextBlock x:Name="DemoModeIndicator" Text="DEMO" FontSize="11" FontWeight="Bold" Foreground="#FFD28C" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
      <Button x:Name="DemoToggle" Content="▶ DEMO" Style="{StaticResource GoldAction}" Padding="12,8" Margin="0,0,8,0" Click="DemoMode_Click" AutomationProperties.Name="Offline DEMO mód be- és kikapcsolása"/>
      <Border Background="#203F3B" CornerRadius="8" Padding="10,8" Margin="0,0,8,0"><TextBlock x:Name="VersionBadge" Text="WPF" Foreground="#73DDC8" FontSize="11"/></Border>
      <Border Background="#433122" CornerRadius="8" Padding="10,8"><TextBlock x:Name="SupervisorBadge" Text="Supervisor: ellenőrzés" Foreground="#F4BB78" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="146"/></Border>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1">
    <ScrollViewer x:Name="Dashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource SurfaceWindow}">
     <StackPanel Margin="18,0,18,14">
      <Border Height="112" Background="{StaticResource SurfacePanel}"
        BorderBrush="{StaticResource SurfaceLine}" BorderThickness="0,0,0,1"
        CornerRadius="0" ClipToBounds="True" Margin="0,0,0,9">
       <Grid>
        <Image x:Name="HeroImage" Source="/Assets/kingdom-hero.jpg" Stretch="UniformToFill"
         RenderOptions.BitmapScalingMode="HighQuality" Opacity="0.17"
         RenderTransformOrigin="0.5,0.5">
         <Image.RenderTransform><ScaleTransform ScaleX="1.015" ScaleY="1.015"/></Image.RenderTransform>
        </Image>
        <Rectangle Fill="#C810161B"/>
        <Ellipse x:Name="AmbientGlow" HorizontalAlignment="Right" VerticalAlignment="Top"
          Width="200" Height="150" Fill="#165BC4B7" Opacity="0.03" IsHitTestVisible="False"/>
        <Grid Margin="20,16,20,14">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="Áttekintés" Foreground="{StaticResource TextStrong}"
            FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Text="Untamed Kingdom  ·  Szerverüzemeltetés és cluster"
            Foreground="{StaticResource TextSoft}" FontSize="12" Margin="0,7,0,0"/>
         </StackPanel>
         <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Style="{StaticResource ActionButton}" Content="Szerverek" Tag="servers" Click="Navigate_Click"/>
          <Button Style="{StaticResource ActionButton}" Content="Mod Center" Tag="mods" Click="Navigate_Click"/>
          <Button Style="{StaticResource PrimaryAction}" Content="Frissítések" Tag="license" Click="Navigate_Click"/>
         </WrapPanel>
        </Grid>
       </Grid>
      </Border>
      <UniformGrid Columns="4" Margin="0,10,0,0">
       <Border Style="{StaticResource NeonStatPanel}"><StackPanel><TextBlock Text="◇  TÉRKÉPEK" Foreground="#9DB7B2"/><TextBlock x:Name="ClusterMapCount" Text="0" Foreground="#A6F873" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock Text="Regisztrált / utoljára látott" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
       <Border Style="{StaticResource NeonStatPanel}"><StackPanel><TextBlock Text="▤  GAZDAGÉPEK" Foreground="#9DB7B2"/><TextBlock x:Name="ClusterHostCount" Text="1" Foreground="White" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock Text="Külön Windows gépek" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
       <Border Style="{StaticResource NeonStatPanel}"><StackPanel><TextBlock Text="⬡  HELYI MODOK" Foreground="#9DB7B2"/><TextBlock x:Name="ConfiguredModCount" Text="—" Foreground="#73DDC8" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock x:Name="ModReadingCoverage" Text="Nincs még mérés" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
       <Border Style="{StaticResource AmberStatPanel}"><StackPanel><TextBlock Text="◉  FRISS LAN-PEER" Foreground="#9DB7B2"/><TextBlock x:Name="ClusterOnlineCount" Text="0" Foreground="#F4BB78" FontSize="31" FontWeight="Bold" Margin="0,4,0,3"/><TextBlock Text="0, ha nincs hiteles peer-mérés" FontSize="11" Foreground="#9DB7B2"/></StackPanel></Border>
      </UniformGrid>

      <Grid Margin="0,15,0,18">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7*" MinWidth="405"/>
        <ColumnDefinition Width="3*" MinWidth="270"/>
       </Grid.ColumnDefinitions>
       <Border Grid.Column="0" Background="{StaticResource SurfacePanel}"
               BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1"
               CornerRadius="10" Padding="12,12,8,10" Margin="0,0,12,0">
        <StackPanel>
         <DockPanel Margin="5,0,4,12" LastChildFill="False">
          <TextBlock Text="Szerverek / cluster" Foreground="{StaticResource TextStrong}"
                     FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button DockPanel.Dock="Right" Content="⟳ Frissítés"
                  Click="DashboardRefresh_Click" Style="{StaticResource ActionButton}"
                  AutomationProperties.Name="Dashboard állapotok frissítése"/>
         </DockPanel>
         <Grid Height="32" Background="{StaticResource SurfaceRaised}" Margin="0,0,10,8">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="80"/><ColumnDefinition Width="2*"/>
           <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.4*"/>
           <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Text="TÉRKÉP" Foreground="{StaticResource TextSoft}"
                     FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="GAZDA" Foreground="{StaticResource TextSoft}"
                     FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="ÁLLAPOT" Foreground="{StaticResource TextSoft}"
                     FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="MŰVELET" Foreground="{StaticResource TextSoft}"
                     FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
         </Grid>
      <Border x:Name="MapListEmpty" Background="#152629" BorderBrush="#3D6467" BorderThickness="1"
              CornerRadius="14" Padding="25,22" Margin="0,0,10,14" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Készen áll az első szervered" FontSize="22" FontWeight="SemiBold" Foreground="#ECFFF8"/>
          <TextBlock Text="Még nincs regisztrált map. Választhatsz egy helyi telepítést, vagy egyből felfedezheted a kezelőfelületet offline mintaclusterrel."
                     FontSize="13" Foreground="#B3CAC7" TextWrapping="Wrap" Margin="0,7,0,15"/>
          <WrapPanel>
            <Button Style="{StaticResource PrimaryAction}" Content="＋  Map hozzáadása" Click="Navigate_Click" Tag="servers"/>
            <Button Style="{StaticResource GoldAction}" Content="▶  DEMO kipróbálása" Click="DemoMode_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="ServerCards">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Style="{StaticResource MapCardButton}" Height="62"
           Margin="0,0,0,6" HorizontalAlignment="Stretch"
           Tag="{Binding}" Click="Map_Click" ToolTip="{Binding Caption}">
          <Grid Margin="10,6">
           <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="Auto"/>
           </Grid.ColumnDefinitions>
           <Border Grid.Column="0" Width="58" Height="48" CornerRadius="6" ClipToBounds="True"
             Background="{Binding CoverBrush}" HorizontalAlignment="Left">
            <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
              RenderOptions.BitmapScalingMode="HighQuality"/>
           </Border>
           <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrong}"
              FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding SourceBadge}" Foreground="{StaticResource TextSoft}"
              FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
           <TextBlock Grid.Column="2" Text="{Binding Host}" Foreground="{StaticResource TextSoft}"
              FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
           <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{StaticResource TextStrong}"
              FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
           <TextBlock Grid.Column="4" Text="Részletek  ›" Foreground="{StaticResource AccentLight}"
              Margin="10,0,3,0" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>

        </StackPanel>
       </Border>
       <StackPanel Grid.Column="1">
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
         <StackPanel>
          <TextBlock Text="Gazdagépek / infrastruktúra" Foreground="{StaticResource TextStrong}"
                     FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <ItemsControl x:Name="HostCards">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border MinHeight="94" Margin="0,0,0,9" Background="{StaticResource SurfaceRaised}" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1" CornerRadius="8" Padding="13,10">
          <StackPanel>
           <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
           <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSoft}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding TrustState}" FontSize="11" Foreground="{Binding Accent}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
           <Grid Margin="0,10,0,0">
            <Grid.Style>
             <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding HasTelemetry}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
             <ColumnDefinition Width="35"/><ColumnDefinition Width="*"/>
             <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="17"/><RowDefinition Height="17"/></Grid.RowDefinitions>
            <TextBlock Grid.Column="0" Text="CPU" Foreground="{StaticResource TextSoft}" FontSize="10"/>
            <ProgressBar Grid.Column="1" Value="{Binding CpuPercent,FallbackValue=0}" Style="{StaticResource PremiumMeter}"
                         Maximum="100" Height="6" Margin="4,1,7,0" VerticalAlignment="Top"/>
            <TextBlock Grid.Column="2" Text="{Binding CpuLabel}" Foreground="{StaticResource TextSoft}" FontSize="10" TextAlignment="Right"/>
            <TextBlock Grid.Row="1" Text="RAM" Foreground="{StaticResource TextSoft}" FontSize="10"/>
            <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding RamPercent,FallbackValue=0}"
                         Style="{StaticResource PremiumMeter}" Maximum="100" Height="6" Margin="4,1,7,0" VerticalAlignment="Top"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding RamLabel}" Foreground="{StaticResource TextSoft}" FontSize="10" TextAlignment="Right"/>
           </Grid>
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>

         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
         <StackPanel>
          <TextBlock Text="Erőforrások és felügyelet" FontSize="16"
                     FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,6"/>
      <StackPanel Margin="0,4,0,0">

       <Border Style="{StaticResource NeonStatPanel}" Margin="0,0,0,9">
        <StackPanel><TextBlock Text="LOCAL SYSTEM / CPU + MEMORY" FontSize="11" Foreground="#8BAAAE" Margin="0,0,0,6"/>
         <TextBlock x:Name="LocalHostResourceStatus" Text="Helyi CPU / RAM: még nincs mért Windows-adat" Foreground="#DCEEE8" TextWrapping="Wrap" FontSize="12"/></StackPanel>
       </Border>
       <Border Style="{StaticResource NeonStatPanel}" Margin="0,0,0,9">
        <StackPanel><TextBlock Text="SUPERVISOR / PROCESS OBSERVATION" FontSize="11" Foreground="#8BAAAE" Margin="0,0,0,6"/>
         <TextBlock x:Name="SupervisorStatus" Text="Supervisor: Ismeretlen – nincs friss, hitelesített mérés" TextWrapping="Wrap" Foreground="#C5D9D9" FontSize="12"/></StackPanel>
       </Border>
      </StackPanel>


         </StackPanel>
        </Border>
        <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
         <StackPanel>
          <TextBlock Text="Legutóbbi állapot / biztonság" FontSize="16"
                     FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" Margin="0,0,0,7"/>
      <Border Background="#14272B" BorderBrush="#354E51" BorderThickness="1"
              CornerRadius="11" Padding="13,11" Margin="0,6,12,10">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Right" Content="◉  Monitoring" Tag="monitoring"
                  Click="Navigate_Click" Style="{StaticResource ActionButton}" Padding="11,6"/>
          <StackPanel>
            <TextBlock Text="OPERATIONAL SNAPSHOT" Foreground="#79BBAF" FontSize="10"
                       FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBlock x:Name="DashboardOperationsLine" Text="Folyamatok, játékosok és RCON állapota még nincs hitelesítve."
                       Foreground="#CCDCDD" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

         </StackPanel>
        </Border>
        <TextBlock Text="Store-v1 · megőrzött formátum · távoli adatok csak hiteles friss peerből"
                   Foreground="{StaticResource TextSoft}" FontSize="10" TextWrapping="Wrap" Margin="9,0,0,8"/>
       </StackPanel>
      </Grid>
     </StackPanel>
    </ScrollViewer>
    <ScrollViewer x:Name="OtherPage" Background="{StaticResource SurfaceWindow}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="24,22,24,40">
      <Border CornerRadius="9" Height="100" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1" ClipToBounds="True" Margin="0,0,0,16">
       <Grid>
        <Image Source="/Assets/kingdom-hero.jpg" Stretch="UniformToFill" Opacity="0.13"/>
        <Rectangle Fill="{StaticResource Night}"/>
        <StackPanel VerticalAlignment="Center" Margin="20,10,24,10">
         <TextBlock x:Name="PageEyebrow" Text="UNTAMED KINGDOM  /  MANAGEMENT" Foreground="#99F1D9" FontSize="12" FontWeight="SemiBold"/>
         <TextBlock x:Name="PageTitle" Text="Szerverek" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,3"/>
         <TextBlock x:Name="PageDescription" Text="Adatelemzés" Foreground="#B8E2D7" TextWrapping="Wrap" FontSize="13"/>
        </StackPanel>
       </Grid>
      </Border>
      <StackPanel x:Name="PageBody"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <Border Grid.Row="2" Background="#0D2425" BorderBrush="#325650" BorderThickness="0,1,0,0" Padding="15,7">
    <DockPanel LastChildFill="False"><TextBlock x:Name="ClusterStatusText" Text="●  Nincs kézzel hozzáadott helyi map · peer nincs csatlakoztatva" Foreground="#73DDC8" FontSize="11"/>
     <TextBlock Text="UNTAMED KINGDOM" DockPanel.Dock="Right" Foreground="#92AAA6" FontSize="11"/></DockPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
