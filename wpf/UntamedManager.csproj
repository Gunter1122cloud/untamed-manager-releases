<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>UntamedManager</AssemblyName>
    <ApplicationIcon>Assets/UntamedManager.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup><Resource Include="Assets/kingdom-hero.jpg" /><Resource Include="Assets/reference-atlas.jpg" /><Resource Include="Assets/UntamedManager.ico" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../docs/development/WORK-LEDGER.json" LogicalName="UntamedManager.WorkLedger.json" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Updater/**/*.cs" />
    <Compile Remove="Testing/**/*.cs" />
    <Compile Remove="Supervisor/**/*.cs" />
    <!-- The shipped native WPF Manager is also database-free. Legacy SQL
         sources remain in git for historical tests only; not in the EXE. -->
    <Compile Remove="MainWindow.Sql.cs" />
    <Compile Remove="Core/MariaDb*.cs" />
    <Compile Remove="Core/OfflineSqlArchive.cs" />
    <Compile Remove="Core/OfflineClusterBackup.cs" />
    <Compile Remove="Core/ClusterRestoreCoordinator.cs" />
  </ItemGroup>
</Project>
