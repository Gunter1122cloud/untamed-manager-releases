<Application x:Class="UntamedManager.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:UntamedManager"
 StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/PremiumTheme.xaml" /></ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="PremiumBackupRow">
      <Grid Height="58" Margin="5,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="99"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="▣" FontSize="15"
          VerticalAlignment="Center" Foreground="{StaticResource AccentLight}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
            Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Description}" FontSize="11"
            Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"
            Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource SurfaceRaised}" CornerRadius="6"
          Padding="6,5" Margin="5,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="IntegrityStatus" Text="{Binding Quality}"
            Foreground="{StaticResource AccentLight}" FontSize="10"
            HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Entry.Valid}" Value="False">
          <Setter TargetName="IntegrityStatus" Property="Foreground"
            Value="{StaticResource ErrorBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="PremiumServerRow">
      <Grid Height="61" Margin="5,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="▤" FontSize="15" VerticalAlignment="Center"
          Foreground="{StaticResource AccentLight}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
            Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding State}" FontSize="11" Margin="0,5,0,0"
            Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" FontSize="10"
            Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PremiumPluginRow">
      <Grid Height="54" Margin="5,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="118"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}"
          Width="21" Height="21" VerticalAlignment="Center" CornerRadius="5">
          <TextBlock Text="✳" Foreground="{StaticResource AccentLight}"
            FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
            Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Hint}" FontSize="10"
            Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"
            Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource SurfaceRaised}"
          CornerRadius="6" Padding="6,5" VerticalAlignment="Center"
          Margin="5,0,0,0">
          <TextBlock Text="{Binding State}" FontSize="10" FontWeight="SemiBold"
            HorizontalAlignment="Center" Foreground="{StaticResource TextStrong}"/>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PremiumModRow">
      <Grid Margin="6,5" Height="49">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Position}" VerticalAlignment="Center"
          Foreground="{StaticResource TextSoft}" FontSize="12"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Id, StringFormat='Projekt {0}'}"
            Foreground="{StaticResource TextStrong}" FontWeight="SemiBold" FontSize="13"/>
          <TextBlock Text="{Binding Information}" Foreground="{StaticResource TextSoft}"
            FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource SurfaceRaised}"
          CornerRadius="6" Padding="7,4" VerticalAlignment="Center">
          <TextBlock Text="{Binding State}" Foreground="{StaticResource TextStrong}"
            FontSize="11" HorizontalAlignment="Center"/>
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PremiumModInventoryCard">
      <Border Background="#192B30" BorderBrush="#35525A" BorderThickness="0,0,0,1"
              Padding="12,9" Margin="0,0,0,3" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="⬡" FontSize="20" Foreground="#65C5B5"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Id, StringFormat='Modprojekt {0}'}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#F0FFFA"/>
            <TextBlock Text="{Binding Detail}" Foreground="#AAC2C5"
                       FontSize="11" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Map, StringFormat='Map: {0}'}" Foreground="#81B9B1"
                       FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding Mode}" FontSize="11" FontWeight="Bold"
                       Foreground="{Binding Accent}" TextAlignment="Right"/>
            <TextBlock Text="{Binding Order, StringFormat='Pozíció: {0}'}"
                       Foreground="#A9C0C1" FontSize="10" TextAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
        <LinearGradientBrush x:Key="MetalTitleBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#E8F7F4" Offset="0.35"/>
      <GradientStop Color="#9FBABC" Offset="0.67"/>
      <GradientStop Color="#FFFFFF" Offset="0.94"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideArtGradient" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#071719" Offset="0"/>
      <GradientStop Color="#062D2C" Offset="0.77"/>
      <GradientStop Color="#00342F" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F6FFF9"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#9ACCC4" BlurRadius="4" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeroIcon" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="Foreground" Value="#4CF6DB"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#1BFFE2" BlurRadius="13" ShadowDepth="0" Opacity="0.78"/></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Accent" Color="#A6F873"/>
    <SolidColorBrush x:Key="Teal" Color="#72DED0"/>
    <SolidColorBrush x:Key="Muted" Color="#9DB7B2"/>
    <!-- Premium navigation: state owned by one attached DP, never by mutable local brushes. -->
    <Style x:Key="NavKeyboardFocus" TargetType="{x:Type Control}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="#5BC4B7" BorderThickness="2" CornerRadius="11"
                    Margin="1" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="NavButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A9BBBD"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,8,12,8"/>
      <Setter Property="Margin" Value="10,1,10,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="9" SnapsToDevicePixels="True">
              <Grid ClipToBounds="True">
                <Border x:Name="SelectionRail" Width="3" HorizontalAlignment="Left"
                        Background="#6AF1C4" CornerRadius="2" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#243139"/>
                <Setter Property="Foreground" Value="#F1FFFA"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#295248"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="local:NavSelection.IsCurrent" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#24443C"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#346F60"/>
                <Setter TargetName="SelectionRail" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="#E9FFF6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="local:NavSelection.IsCurrent" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="Background" Value="#2B4C44"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#5BC4B7"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Premium low-motion buttons: no focus jumps or scaling. -->
    <Style TargetType="Button" x:Key="ActionButton">
      <Setter Property="Background" Value="#233037"/>
      <Setter Property="Foreground" Value="#E7F7F3"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="#334249"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="MinHeight" Value="35"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,9,5"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}"
             CornerRadius="8" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
               RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="#53756E"/>
              <Setter TargetName="Surface" Property="Background" Value="#304149"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#2B5950"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#5BC4B7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryAction" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#23896D"/><Setter Property="BorderBrush" Value="#3E9F87"/>
    </Style>
    <Style TargetType="Button" x:Key="GoldAction" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#3C372D"/><Setter Property="BorderBrush" Value="#947E55"/>
    </Style>
    <Style TargetType="Border" x:Key="Panel">
      <Setter Property="Background" Value="{StaticResource SurfacePanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>
    <Style TargetType="Border" x:Key="NeonStatPanel" BasedOn="{StaticResource Panel}">
      <Setter Property="Background" Value="{StaticResource SurfacePanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceLine}"/>
    </Style>
    <Style TargetType="Border" x:Key="AmberStatPanel" BasedOn="{StaticResource NeonStatPanel}">
      <Setter Property="BorderBrush" Value="#63523A"/>
    </Style>
  </ResourceDictionary>
  </Application.Resources>
</Application>