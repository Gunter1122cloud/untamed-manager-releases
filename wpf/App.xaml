<Application x:Class="UntamedManager.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:UntamedManager"
 StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
       <ResourceDictionary Source="Styles/GraphiteTokens.xaml"/>
       <ResourceDictionary Source="Styles/PremiumTheme.xaml"/>
       <ResourceDictionary Source="Styles/GraphiteChrome.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="PremiumLogRow">
      <Grid Margin="4,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="105"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SurfaceRaised}"
          Padding="6,4" Margin="0,0,10,0" CornerRadius="5" VerticalAlignment="Top">
          <TextBlock Text="{Binding Level}" Foreground="{Binding LevelBrush}"
            FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
            HorizontalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Content}" FontFamily="Consolas"
          FontSize="12" Foreground="{StaticResource TextStrong}"
          TextWrapping="Wrap" TextTrimming="None"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PremiumBackupRow">
      <Grid Height="58" Margin="5,5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="99"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="▣" FontSize="15"
          VerticalAlignment="Center" Foreground="{StaticResource AccentLight}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
            Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Description}" FontSize="11"
            Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"
            Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource SurfaceRaised}" CornerRadius="6"
          Padding="6,5" Margin="5,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="IntegrityStatus" Text="{Binding Quality}"
            Foreground="{StaticResource AccentLight}" FontSize="10"
            HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Border>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Entry.Valid}" Value="False">
          <Setter TargetName="IntegrityStatus" Property="Foreground"
            Value="{StaticResource ErrorBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="CurseForgeSearchRow">
       <Grid Height="72" Margin="4,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Grid.Column="0" Width="60" Height="60" CornerRadius="8"
                 BorderBrush="#46776D" BorderThickness="1" Background="#1B3F3B"
                 ClipToBounds="True" VerticalAlignment="Center">
           <Grid>
             <TextBlock Text="⬡" Foreground="{StaticResource AccentLight}" FontSize="28"
                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
             <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill" IsHitTestVisible="False"
                RenderOptions.BitmapScalingMode="HighQuality"/>
           </Grid>
         </Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,6,0">
           <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
             Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Id, StringFormat='CURSEFORGE ID  {0}'}" FontSize="10"
             Foreground="{StaticResource AccentLight}" Margin="0,5,0,0"/>
           <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,5,0,0"
             Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
       </Grid>
     </DataTemplate>
     <DataTemplate x:Key="PremiumServerRow">
       <Grid Height="78" Margin="4,4">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="62" Height="62" VerticalAlignment="Center"
          Background="#19393A" BorderBrush="#47776E" BorderThickness="1"
          CornerRadius="8" ClipToBounds="True">
         <Grid>
          <Image Source="{Binding CoverImage}" Stretch="UniformToFill" Opacity="0.9"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Rectangle Fill="#4E071B20" IsHitTestVisible="False"/>
         </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,4,0">
         <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
          Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding State}" FontSize="11" Margin="0,6,0,0"
          Foreground="{StaticResource AccentLight}" TextTrimming="CharacterEllipsis"/>
         <TextBlock Text="{Binding Detail}" FontSize="10" Margin="0,4,0,0"
          Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
       </Grid>
     </DataTemplate>
    <DataTemplate x:Key="PremiumPluginRow">
      <Grid Height="58" Margin="8,2" ToolTip="{Binding Hint}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="108"/><ColumnDefinition Width="65"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1" CornerRadius="7"
                VerticalAlignment="Center">
          <TextBlock Text="✳" Foreground="{StaticResource AccentLight}" FontSize="15"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,5,0">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                     Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Hint}" FontSize="10" Margin="0,4,0,0"
                     Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11"
                   Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <ToggleButton Grid.Column="3" Style="{StaticResource PremiumSwitch}"
                      IsChecked="{Binding Enabled,Mode=OneWay}"
                      Command="{Binding ToggleCommand}"
                      IsEnabled="{Binding CanToggle}" HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Plugin engedélyezése vagy letiltása"
                      ToolTip="Állapotváltás – a biztonsági ellenőrzés és megerősítés kötelező"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PremiumModRow">
      <Grid Height="60" Margin="8,2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="62"/><ColumnDefinition Width="84"/>
          <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource SurfaceRaised}"
                BorderBrush="{StaticResource SurfaceLine}" BorderThickness="1" CornerRadius="7"
                VerticalAlignment="Center">
          <TextBlock Text="⬡" FontSize="15" Foreground="{StaticResource AccentLight}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,5,0">
          <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding ProjectLabel}" FontSize="10"
                     Foreground="{StaticResource TextSoft}" Margin="0,4,0,0"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Position,StringFormat='#{0}'}"
                   Foreground="{StaticResource TextSoft}" FontSize="12"
                   TextAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{StaticResource TextSoft}"
                   FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
        <ToggleButton Grid.Column="4" IsChecked="{Binding IsActive,Mode=OneWay}"
                      Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}"
                      Style="{StaticResource PremiumSwitch}" HorizontalAlignment="Center"
                      VerticalAlignment="Center" ToolTip="Aktiválás / letiltás – DEMO vagy függő módosítás"
                      AutomationProperties.Name="Mod aktiválása vagy letiltása"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="PremiumModInventoryCard">
      <Border Background="#192B30" BorderBrush="#35525A" BorderThickness="0,0,0,1"
              Padding="12,9" Margin="0,0,0,3" CornerRadius="6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="⬡" FontSize="20" Foreground="#65C5B5"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="{Binding Id, StringFormat='Modprojekt {0}'}"
                       FontSize="13" FontWeight="SemiBold" Foreground="#F0FFFA"/>
            <TextBlock Text="{Binding Detail}" Foreground="#AAC2C5"
                       FontSize="11" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Map, StringFormat='Map: {0}'}" Foreground="#81B9B1"
                       FontSize="11"/>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding Mode}" FontSize="11" FontWeight="Bold"
                       Foreground="{Binding Accent}" TextAlignment="Right"/>
            <TextBlock Text="{Binding Order, StringFormat='Pozíció: {0}'}"
                       Foreground="#A9C0C1" FontSize="10" TextAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
        <LinearGradientBrush x:Key="MetalTitleBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#E8F7F4" Offset="0.35"/>
      <GradientStop Color="#9FBABC" Offset="0.67"/>
      <GradientStop Color="#FFFFFF" Offset="0.94"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideArtGradient" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#071719" Offset="0"/>
      <GradientStop Color="#062D2C" Offset="0.77"/>
      <GradientStop Color="#00342F" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource GraphitePrimary}"/>
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="HeroIcon" TargetType="TextBlock">
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="Foreground" Value="{StaticResource GraphiteAccent}"/>
    </Style>
    <SolidColorBrush x:Key="Accent" Color="#71C6B9"/>
    <SolidColorBrush x:Key="Teal" Color="#71C6B9"/>
    <SolidColorBrush x:Key="Muted" Color="#9DB7B2"/>
    <!-- Premium navigation: state owned by one attached DP, never by mutable local brushes. -->
    <Style x:Key="NavKeyboardFocus" TargetType="{x:Type Control}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="#5BC4B7" BorderThickness="2" CornerRadius="11"
                    Margin="1" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="NavButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A9BBBD"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="MinHeight" Value="43"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,8,12,8"/>
      <Setter Property="Margin" Value="10,2,10,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="9" SnapsToDevicePixels="True">
              <Grid ClipToBounds="True">
                <Border x:Name="SelectionRail" Width="3" HorizontalAlignment="Left"
                        Background="#6AF1C4" CornerRadius="2" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#243139"/>
                <Setter Property="Foreground" Value="#F1FFFA"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#295248"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="local:NavSelection.IsCurrent" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#24443C"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#346F60"/>
                <Setter TargetName="SelectionRail" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="#E9FFF6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="local:NavSelection.IsCurrent" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="Background" Value="#2B4C44"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#5BC4B7"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Premium low-motion buttons: no focus jumps or scaling. -->
    <Style TargetType="Button" x:Key="ActionButton">
      <Setter Property="Background" Value="#233037"/>
      <Setter Property="Foreground" Value="#E7F7F3"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="#334249"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,5"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}"
             BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}"
             CornerRadius="8" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
               RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="BorderBrush" Value="#53756E"/>
              <Setter TargetName="Surface" Property="Background" Value="#304149"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="#2B5950"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="#5BC4B7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Surface" Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryAction" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#2B7368"/><Setter Property="BorderBrush" Value="#468F83"/>
    </Style>
    <Style TargetType="Button" x:Key="GoldAction" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#35322D"/><Setter Property="BorderBrush" Value="#72654B"/>
    </Style>
    <Style TargetType="Border" x:Key="Panel">
      <Setter Property="Background" Value="{StaticResource SurfacePanel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
    <Style TargetType="Border" x:Key="NeonStatPanel" BasedOn="{StaticResource Panel}">
      <Setter Property="Background">
       <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#203E3D" Offset="0"/>
        <GradientStop Color="#15262B" Offset="0.55"/>
        <GradientStop Color="#122124" Offset="1"/>
       </LinearGradientBrush></Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#42675F"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="17,15"/>
     </Style>
    <Style TargetType="Border" x:Key="AmberStatPanel" BasedOn="{StaticResource NeonStatPanel}">
      <Setter Property="BorderBrush" Value="#63523A"/>
    </Style>
  </ResourceDictionary>
  </Application.Resources>
</Application>