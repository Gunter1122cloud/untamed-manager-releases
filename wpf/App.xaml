<Application x:Class="UntamedManager.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:UntamedManager"
 StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F9F5"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#102F30"/>
      <Setter Property="Foreground" Value="#ECFFF8"/>
      <Setter Property="BorderBrush" Value="#2F8176"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CaretBrush" Value="#9AFFDC"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="SelectionBrush" Value="#267D6F"/>
      <Style.Triggers>
       <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="#8AFFD1"/>
       </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#0B282A"/>
      <Setter Property="Foreground" Value="#ECFFF8"/>
      <Setter Property="BorderBrush" Value="#2A7770"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E3FFF5"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#E5F3ED"/>
      <Setter Property="Foreground" Value="#16342C"/>
      <Setter Property="BorderBrush" Value="#418F7D"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#17372F"/>
      <Setter Property="Background" Value="#E4F7EE"/>
      <Setter Property="Padding" Value="8,5"/>
      <Style.Triggers>
       <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#8BD6BC"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#183B34"/>
      <Setter Property="Background" Value="#DCEFE6"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Style.Triggers>
       <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#116B53"/>
        <Setter Property="Foreground" Value="White"/>
       </Trigger>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="#6FE2BA"/>
       </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#E8FFF8"/><Setter Property="Padding" Value="10,7"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#205746"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#21443E"/></Trigger>
      </Style.Triggers>
    </Style>
        <LinearGradientBrush x:Key="MetalTitleBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFF" Offset="0"/>
      <GradientStop Color="#E8F7F4" Offset="0.35"/>
      <GradientStop Color="#9FBABC" Offset="0.67"/>
      <GradientStop Color="#FFFFFF" Offset="0.94"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideArtGradient" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#071719" Offset="0"/>
      <GradientStop Color="#062D2C" Offset="0.77"/>
      <GradientStop Color="#00342F" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F6FFF9"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#9ACCC4" BlurRadius="4" ShadowDepth="0" Opacity="0.38"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="HeroIcon" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="Foreground" Value="#4CF6DB"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#1BFFE2" BlurRadius="13" ShadowDepth="0" Opacity="0.78"/></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="Accent" Color="#A6F873"/>
    <SolidColorBrush x:Key="Teal" Color="#72DED0"/>
    <SolidColorBrush x:Key="Muted" Color="#9DB7B2"/>
    <!-- Premium navigation: state owned by one attached DP, never by mutable local brushes. -->
    <Style x:Key="NavKeyboardFocus" TargetType="{x:Type Control}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border BorderBrush="#F5DC9D" BorderThickness="2" CornerRadius="11"
                    Margin="1" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="NavButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#B6CBC7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource NavKeyboardFocus}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="15,8,12,8"/>
      <Setter Property="Margin" Value="10,1,10,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="9" SnapsToDevicePixels="True">
              <Grid ClipToBounds="True">
                <Border x:Name="SelectionRail" Width="3" HorizontalAlignment="Left"
                        Background="#6AF1C4" CornerRadius="2" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    RecognizesAccessKey="True"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#193735"/>
                <Setter Property="Foreground" Value="#F1FFFA"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#275A4B"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="local:NavSelection.IsCurrent" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="#164C41"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#428B78"/>
                <Setter TargetName="SelectionRail" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="#E9FFF6"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="local:NavSelection.IsCurrent" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="Background" Value="#1E5A49"/>
                <Setter TargetName="Surface" Property="BorderBrush" Value="#67C9A9"/>
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.38"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="ActionButton">
  <Setter Property="Background" Value="#123B3D"/><Setter Property="Foreground" Value="White"/>
  <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
  <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="1"/>
  <Setter Property="BorderBrush" Value="#3CDACB"/><Setter Property="Padding" Value="21,13"/>
  <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,12,0"/>
  <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#00D6C1" BlurRadius="10" Opacity="0.27" ShadowDepth="0"/></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
      <Grid><Border x:Name="Glow" Background="#39A0FFE9" CornerRadius="9" Opacity="0"/>
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.43" Duration="0:0:0.17"/>
          <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.04" Duration="0:0:0.18"/>
          <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.04" Duration="0:0:0.18"/>
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
          <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
          <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
</Style>
    <Style TargetType="Button" x:Key="PrimaryAction" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#087848"/><Setter Property="BorderBrush" Value="#7AFFB7"/>
    </Style>
    <Style TargetType="Button" x:Key="GoldAction" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="#503C18"/><Setter Property="BorderBrush" Value="#EFC26C"/>
    </Style>
    <Style TargetType="Border" x:Key="Panel">
      <Setter Property="Background" Value="#152025"/>
      <Setter Property="BorderBrush" Value="#354C51"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="17"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>

    <Style TargetType="Border" x:Key="NeonStatPanel" BasedOn="{StaticResource Panel}">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A2B2F" Offset="0"/>
            <GradientStop Color="#101B20" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="BorderBrush" Value="#355F61"/>
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#00E8C2" BlurRadius="12" ShadowDepth="0" Opacity="0.08"/></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Border" x:Key="AmberStatPanel" BasedOn="{StaticResource NeonStatPanel}">
      <Setter Property="BorderBrush" Value="#C28A38"/>
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect Color="#FFB33C" BlurRadius="16" ShadowDepth="0" Opacity="0.16"/></Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>