<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="GraphitePageTitle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="Segoe UI"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="26"/>
  <Setter Property="Foreground" Value="{StaticResource GraphitePrimary}"/>
  <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
 </Style>
 <Style x:Key="GraphiteSectionTitle" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="Segoe UI"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="17"/>
  <Setter Property="Foreground" Value="{StaticResource GraphitePrimary}"/>
 </Style>
 <Style x:Key="GraphiteCaption" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Foreground" Value="{StaticResource GraphiteMuted}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="GraphitePanelStyle" TargetType="Border">
  <Setter Property="Background" Value="{StaticResource GraphitePanel}"/>
  <Setter Property="BorderBrush" Value="{StaticResource GraphiteBorder}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="{StaticResource GraphiteCardRadius}"/>
  <Setter Property="Padding" Value="{StaticResource GraphiteCardPadding}"/>
  <Setter Property="Margin" Value="0,0,12,12"/>
 </Style>
 <Style x:Key="GraphiteToolbar" TargetType="Border" BasedOn="{StaticResource GraphitePanelStyle}">
  <Setter Property="Padding" Value="12,11"/>
  <Setter Property="Margin" Value="0,0,0,14"/>
 </Style>
 <Style x:Key="GraphiteMutedDivider" TargetType="Separator">
  <Setter Property="Background" Value="{StaticResource GraphiteBorder}"/>
  <Setter Property="Height" Value="1"/>
  <Setter Property="Margin" Value="0,11"/>
 </Style>
</ResourceDictionary>