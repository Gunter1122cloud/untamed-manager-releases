<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UntamedDesktop</AssemblyName>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <ApplicationIcon>../wpf/Assets/UntamedManager.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <!-- Obsidian Command is the supported Windows Manager.
       It reuses selected shared C# Core implementation sources; historical
       WPF screens are not shipped, maintained or required by this host. -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <!-- Shipping Obsidian: shared runtime Core only. No database writers,
         old WPF demo, fake ASA, fake SteamCMD or synthetic restore harness.
         Synthetic fixtures are compiled into DesktopBridgeTests separately. -->
    <Compile Include="../wpf/Core/*.cs"
             Exclude="../wpf/Core/MariaDb*.cs;../wpf/Core/OfflineSqlArchive.cs;../wpf/Core/OfflineClusterBackup.cs;../wpf/Core/ClusterRestoreCoordinator.cs;../wpf/Core/DemoWorkspace.cs;../wpf/Core/IsolatedFakeAsaSession.cs;../wpf/Core/IntegrationTestAccess.cs;../wpf/Core/SyntheticRestore.cs;../wpf/Core/SteamCmdTestRunner.cs;../wpf/Core/RecoverySimulation.cs;../wpf/Core/VaultFixtureAudit.cs"
             Link="Core/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../docs/development/WORK-LEDGER.json" LogicalName="UntamedManager.WorkLedger.json" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- Read-only, bounded SQLite BLOB slices for offline ASA -usestore proof. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../desktop-ui/dist/index.html')">
    <Content Include="../desktop-ui/dist/**/*" Link="ui/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
